{
  "name": "@komo/app",
  "version": "0.1.0",
  "private": true,
  "description": "Shared komo renderer — a platform-agnostic React SPA over the gateway's HTTP api channel. Mounted by both the Electron desktop shell (apps/desktop) and the standalone web build (apps/web); each host injects an HttpKomoClient with its own gateway resolver.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles/main.css": "./src/styles/main.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@assistant-ui/react": "0.14.27",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.100.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.27",
    "lucide-react": "^1.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "4.14.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
